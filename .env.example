# ==========================================
# KREATIM — ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/kreatim?schema=public"

# Auth (Better Auth / NextAuth)
AUTH_SECRET="ganti-dengan-random-32-char-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Providers
# Pilih provider: AI_TEXT_PROVIDER=anthropic|gemini|mock, AI_IMAGE_PROVIDER=fal|gemini|mock.
# Jika kosong, dipilih otomatis dari API key yang tersedia. "mock" hanya untuk development
# (diblokir di production kecuali AI_ALLOW_MOCK=1).
AI_TEXT_PROVIDER=""
AI_IMAGE_PROVIDER=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
FAL_KEY=""

# Storage (Cloudflare R2)
# Kosongkan saat development untuk memakai penyimpanan lokal (.dev-uploads/).
# Bucket R2 perlu aturan CORS yang mengizinkan PUT dari NEXT_PUBLIC_APP_URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kreatim-assets"
R2_PUBLIC_BASE_URL="https://assets.kreatim.id"

# Payment Gateway (Midtrans / Tripay)
PAYMENT_PROVIDER="midtrans"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Cron Security
CRON_SECRET="ganti-dengan-random-cron-token"
